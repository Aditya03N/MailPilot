# ==========================================
# MailPilot Root Git Ignore
# Covers both backend (server/) & frontend (client/)
# ==========================================

# Dependencies
node_modules/
*/node_modules/
client/node_modules/
server/node_modules/
.pnp
.pnp.js

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.env
server/.env
server/.env.*
client/.env
client/.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Production Builds
dist/
*/dist/
client/dist/
build/
*/build/

# Logs & Runtime Outputs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Editor & OS Artifacts
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# Temporary Test/Scratch Files
scratch/
tmp/
temp/
